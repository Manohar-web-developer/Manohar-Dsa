
{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "C++: Build and Run",
        "type": "shell",
        "command": "mkdir -p \"${workspaceFolder}/build\" && clang++ -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk -std=c++17 \"${file}\" -o \"${workspaceFolder}/build/${fileBasenameNoExtension}\" && \"${workspaceFolder}/build/${fileBasenameNoExtension}\"",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": "$gcc",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": false
        }
      }
    ]
  }
  